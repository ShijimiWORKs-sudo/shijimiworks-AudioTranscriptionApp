{
  "name": "@audiotranscriptionapp/prototype",
  "version": "0.1.0",
  "private": true,
  "description": "AudioTranscriptionApp 試用版（Prototype）- HP掲載用トライアル版",
  "author": "ShijimiWORKs",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node ../../scripts/dev-electron.mjs prototype",
    "dev:vite-only": "vite",
    "build": "tsc -p tsconfig.json && tsc -p electron/tsconfig.json && node ../../scripts/bundle-preload.mjs prototype && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src electron --ext .ts,.tsx",
    "package": "node ../../scripts/copy-sidecar.mjs prototype && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@audiotranscriptionapp/core": "*",
    "music-metadata": "^10.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "works.shijimi.audiotranscriptionapp.prototype",
    "productName": "AudioTranscriptionApp 試用版",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/asr-sidecar",
        "to": "asr-sidecar",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AudioTranscriptionApp-Prototype-Setup-${version}.${ext}"
    }
  }
}
